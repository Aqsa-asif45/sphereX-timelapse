{
  "name": "spherex-timelapse",
  "version": "0.1.0",
  "private": true,
  "description": "Planet X & SPHEREx: a public time-lapse viewer for SPHEREx near-infrared sky images (NASA Space Apps 2026).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "start": "node dist/server.js",
    "index": "node dist/indexer.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "framer-motion": "11.11.17",
    "preact": "10.24.3"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
