{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "timelens-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "timelens-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "timelens-dev",
      "url": "http://localhost:5173",
      "port": 5173
    }
  ]
}
