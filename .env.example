# Copy this file to backend/.env to change a setting. Every value is optional;
# the defaults below are what the backend uses when nothing is set.
# No secrets or API keys are needed for this project.

HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CUTOUT_CONCURRENCY=32
HTTP_CONCURRENCY=64
MAX_EXPOSURES=400
# CACHE_DIR defaults to backend/data/cache; set it only to move the cache elsewhere (use a full path)
# CACHE_DIR=
NO_SEARCH_CACHE=false
